        "id": "nS3IILTy8DvM"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "api_key = userdata.get(\"GROQ_API_KEY\")\n",
        "client = Groq(api_key=api_key)\n"
      ],
      "metadata": {
        "id": "Yd2ac7Xu8HKk"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------------------------------\n",
        "# Zero-Shot Prompt\n",
        "# ---------------------------------------\n",
        "\n",
        "zero_shot_prompt = \"\"\"\n",
        "Classify the sentiment of the following sentence as Positive, Negative, or Neutral.\n",
        "\n",
        "Sentence:\n",
        "\"The movie was amazing and I really enjoyed it.\"\n",
        "\"\"\"\n",
        "\n",
        "zero_response = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[\n",
        "        {\"role\": \"user\", \"content\": zero_shot_prompt}\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Few-Shot Prompt\n",
        "# ---------------------------------------\n",
        "\n",
        "few_shot_prompt = \"\"\"\n",
        "Classify the sentiment as Positive, Negative, or Neutral.\n",
        "\n",
        "Example 1\n",
        "Sentence: I love this phone.\n",
        "Answer: Positive\n",
        "\n",
        "Example 2\n",
        "Sentence: The food was terrible.\n",
        "Answer: Negative\n",
        "\n",
        "Example 3\n",
        "Sentence: The meeting starts at 10 AM.\n",
        "Answer: Neutral\n",
        "\n",
        "Now classify this sentence.\n",
        "\n",
        "Sentence: The movie was amazing and I really enjoyed it.\n",
        "Answer:\n",
        "\"\"\"\n",
        "\n",
        "few_response = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[\n",
        "        {\"role\": \"user\", \"content\": few_shot_prompt}\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Display Results\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"========== Zero-Shot Prompt ==========\\n\")\n",
        "print(zero_shot_prompt)\n",
        "\n",
        "print(\"\\nOutput:\\n\")\n",
        "print(zero_response.choices[0].message.content)\n",
        "\n",
        "print(\"\\n\\n========== Few-Shot Prompt ==========\\n\")\n",
        "print(few_shot_prompt)\n",
        "\n",
        "print(\"\\nOutput:\\n\")\n",
        "print(few_response.choices[0].message.content)\n"
      ],
